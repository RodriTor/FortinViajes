# ===== Backend (copiar a backend/.env) =====
PORT=3000
# Conexión PostgreSQL (en producción: la cadena que da Neon, con ?sslmode=require)
DATABASE_URL=postgresql://usuario:password@localhost:5432/fortinviajes
# Secreto largo y aleatorio para firmar los JWT. NO usar este valor.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
# Origen(es) exacto(s) del frontend para CORS, separados por coma
FRONTEND_URL=http://localhost:5173
# Solo para correr los tests de integración (usar una base DISTINTA a la real: se borra su contenido)
TEST_DATABASE_URL=postgresql://usuario:password@localhost:5432/fortinviajes_test

# ===== Frontend (se configura en Netlify / frontend/.env) =====
VITE_API_URL=http://localhost:3000/api
